From 48c98c2cd28133a8aaf3c453e7bdf8ee1f8f58e1 Mon Sep 17 00:00:00 2001
From: sp00nz <sp00nz@gmail.com>
Date: Tue, 20 Oct 2026 00:31:48 -0700
Subject: [PATCH 1/4] fix(gpu): skip zero-length indirect buffers and packet
 streams

A count of 0 builds a RingBuffer with capacity 0, and set_write_offset then divides by zero. Hardware treats an empty IB as a no-op.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/graphics/command_processor.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index a744375..d39c4e0 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -636,6 +636,13 @@ uint32_t CommandProcessor::ExecutePrimaryBuffer(uint32_t read_index, uint32_t wr
 void CommandProcessor::ExecuteIndirectBuffer(uint32_t ptr, uint32_t count) {
   SCOPE_profile_cpu_f("gpu");
 
+  // A zero-length indirect buffer has no packets. RingBuffer with capacity 0
+  // makes set_write_offset() do `% 0` (integer #DE). Real hardware tolerates
+  // empty IBs; bail out.
+  if (count == 0) {
+    return;
+  }
+
   // Execute commands!
   memory::RingBuffer reader(memory_->TranslatePhysical(ptr), count * sizeof(uint32_t));
   reader.set_write_offset(count * sizeof(uint32_t));
@@ -650,6 +657,10 @@ void CommandProcessor::ExecuteIndirectBuffer(uint32_t ptr, uint32_t count) {
 }
 
 void CommandProcessor::ExecutePacket(uint32_t ptr, uint32_t count) {
+  // Empty packet stream: capacity 0 would crash set_write_offset (`% 0`).
+  if (count == 0) {
+    return;
+  }
   // Execute commands!
   memory::RingBuffer reader(memory_->TranslatePhysical(ptr), count * sizeof(uint32_t));
   reader.set_write_offset(count * sizeof(uint32_t));
-- 
2.51.0.windows.2


From b2983caea42409c036821ca4182a7eaa16ac7dc3 Mon Sep 17 00:00:00 2001
From: sp00nz <sp00nz@gmail.com>
Date: Tue, 20 Oct 2026 00:31:48 -0700
Subject: [PATCH 2/4] fix(system): don't reset the image heap when reading the
 XEX

Reset() clears the page table for the whole 0x8xxxxxxx heap, which wipes the function dispatcher allocation placed at image_end. A static recomp loads exactly one module, so there is nothing stale to clear.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/system/xex_module.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/system/xex_module.cpp b/src/system/xex_module.cpp
index 46d1d71..96dfc68 100644
--- a/src/system/xex_module.cpp
+++ b/src/system/xex_module.cpp
@@ -464,7 +464,11 @@ int XexModule::ReadImage(const void* xex_addr, size_t xex_length, bool use_dev_k
     return 0;
   }
 
-  memory()->LookupHeap(base_address_)->Reset();
+  // NOTE(sp00nznet): skipped for static recomp. Reset() clears page-table
+  // entries for the whole 0x80000000-0x8FFFFFFF heap, destroying the function
+  // dispatcher allocation at image_end and the .rdata/.pdata page tracking.
+  // We load exactly one module, so there is no stale state to clear.
+  // memory()->LookupHeap(base_address_)->Reset();
 
   aes_decrypt_buffer(use_dev_key ? xe_xex2_devkit_key : xe_xex2_retail_key,
                      reinterpret_cast<const uint8_t*>(xex_security_info()->aes_key), 16,
-- 
