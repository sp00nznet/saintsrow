From 51d2d653ae53a293afdc77514e709b931bd970b6 Mon Sep 17 00:00:00 2001
From: sp00nz <sp00nz@gmail.com>
Date: Tue, 20 Oct 2026 00:31:48 -0700
Subject: [PATCH 3/4] fix(kernel): re-attach native objects when the guest
 rewrites a dispatch header

Some titles re-initialise KEVENT/KSEMAPHORE headers inline between waits, wiping the stashed signature. GetNativeObject then minted a new native object per call (201 for one guest event), so waiters and signallers never met. Remember guest address -> handle and re-attach.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/system/xobject.cpp | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/src/system/xobject.cpp b/src/system/xobject.cpp
index d358f39..9532e16 100644
--- a/src/system/xobject.cpp
+++ b/src/system/xobject.cpp
@@ -9,6 +9,7 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <unordered_map>
 #include <vector>
 
 #include <rex/chrono/clock.h>
@@ -388,14 +389,40 @@ object_ref<XObject> XObject::GetNativeObject(KernelState* kernel_state, void* na
     as_type = header->type;
   }
 
+  // NOTE(sp00nznet): guest addresses we have already associated with an object.
+  // The comment above assumes PPC code never pokes the struct, but some titles
+  // re-initialise dispatch headers inline -- Saints Row does it to its IO event
+  // and semaphore between every wait. That wipes the signature, so the branch
+  // below would mint a brand new object each time: measured 201 distinct native
+  // objects for one guest event, every IO worker parked on its own private copy,
+  // and no signal able to reach any of them. Remembering the handle lets us
+  // re-attach instead of duplicating.
+  static std::unordered_map<uint32_t, uint32_t> associated_handles;
+  uint32_t guest_address = kernel_state->memory()->HostToGuestVirtual(native_ptr);
+
   if (header->wait_list_flink == kXObjSignature) {
     // Already initialized.
     // TODO: assert if the type of the object != as_type
     uint32_t handle = header->wait_list_blink;
     auto object = kernel_state->object_table()->LookupObject<XObject>(handle);
 
+    if (object && guest_address) {
+      associated_handles[guest_address] = handle;
+    }
     // TODO(benvanik): assert nothing has been changed in the struct.
     return object;
+  } else if (auto it = associated_handles.find(guest_address);
+             guest_address && it != associated_handles.end()) {
+    // The guest cleared our signature by re-initialising the header in place.
+    // Re-attach the object it was already using rather than creating another.
+    auto object = kernel_state->object_table()->LookupObject<XObject>(it->second);
+    if (object) {
+      header->wait_list_flink = kXObjSignature;
+      header->wait_list_blink = it->second;
+      return object;
+    }
+    associated_handles.erase(it);
+    return GetNativeObject(kernel_state, native_ptr, as_type);
   } else {
     // First use, create new.
     // https://www.nirsoft.net/kernel_struct/vista/KOBJECTS.html
@@ -444,6 +471,9 @@ object_ref<XObject> XObject::GetNativeObject(KernelState* kernel_state, void* na
     // FIXME: This assumes the object contains a dispatch header (some don't!)
     StashHandle(header, object->handle());
 
+    if (object && guest_address) {
+      associated_handles[guest_address] = object->handle();
+    }
     return object_ref<XObject>(object);
   }
 }
-- 
2.51.0.windows.2


From b64198f4d9012cdcc73c05a7af1d1db4c115ab22 Mon Sep 17 00:00:00 2001
From: sp00nz <sp00nz@gmail.com>
Date: Tue, 20 Oct 2026 00:31:49 -0700
Subject: [PATCH 4/4] feat(system): log unregistered indirect call targets
 instead of aborting

Each (target, lr) pair is logged once and the call returns 0, so one run lists every missing manifest entry rather than one per build/run cycle.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/system/function_dispatcher.cpp | 25 +++++++++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/src/system/function_dispatcher.cpp b/src/system/function_dispatcher.cpp
index bd43109..4330f0b 100644
--- a/src/system/function_dispatcher.cpp
+++ b/src/system/function_dispatcher.cpp
@@ -15,6 +15,9 @@
 
 #include <rex/assert.h>
 #include <rex/dbg.h>
+#include <mutex>
+#include <set>
+
 #include <rex/logging.h>
 #include <rex/perf/counter.h>
 #include <rex/memory.h>
@@ -34,9 +37,27 @@ FunctionDispatcher* GetBoundFunctionDispatcher() {
 
 }  // namespace
 
+// NOTE(sp00nznet): non-fatal for in-progress recomps. A guest indirect call can
+// land on an address codegen never emitted an entry point for -- typically a small
+// function only virtual dispatch reaches, which the scanner folded into its
+// neighbour. Aborting turns each one into a separate build/run cycle to discover
+// the next; returning instead lets a single run report every missing address so
+// they can be added to the manifest in one pass. Each (target, lr) pair is logged
+// once. Revert to REX_FATAL once the manifest is complete.
 static void InvalidFunctionTrap(PPCContext& ctx, uint8_t* /*base*/) {
-  REX_FATAL("Call to invalid or unregistered function at guest address 0x{:08X}",
-            ctx.last_indirect_target);
+  static std::mutex seen_mutex;
+  static std::set<uint64_t> seen;
+  uint64_t key = (uint64_t(ctx.last_indirect_target) << 32) | uint32_t(ctx.lr);
+  bool first;
+  {
+    auto lock = std::lock_guard(seen_mutex);
+    first = seen.insert(key).second;
+  }
+  if (first) {
+    REXCPU_ERROR("Call to invalid or unregistered function at guest address 0x{:08X} (from lr 0x{:08X})",
+                 ctx.last_indirect_target, uint32_t(ctx.lr));
+  }
+  ctx.r3.u64 = 0;
 }
 
 PPCFunc* ResolveIndirectFunction(uint32_t guest_address) {
-- 
